#!/bin/bash
# rmpcd-update - Update binaries and restart daemon (safe, non-destructive)

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
CARGO_DIR="$PROJECT_DIR/rmpc"
RMPCD_BINARY="$CARGO_DIR/target/release/rmpcd"
RMPC_BINARY="$CARGO_DIR/target/release/rmpc"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}=== rmpcd Update ===${NC}"

echo -e "${YELLOW}Building release binaries...${NC}"
cd "$CARGO_DIR"
cargo build --release
cd - >/dev/null

# Verify binaries exist after build attempt
if [ ! -f "$RMPCD_BINARY" ]; then
    echo -e "${RED}❌ rmpcd binary not found at $RMPCD_BINARY${NC}"
    exit 1
fi
if [ ! -f "$RMPC_BINARY" ]; then
    echo -e "${RED}❌ rmpc binary not found at $RMPC_BINARY${NC}"
    exit 1
fi

# Check if daemon is currently running (for confirmation)
WAS_RUNNING=false
if systemctl --user is-active --quiet rmpcd 2>/dev/null; then
    WAS_RUNNING=true
    echo -e "${YELLOW}rmpcd is currently running. It will be restarted.${NC}"
fi

# Stop daemon (required to avoid "Text file busy" on cp)
echo -e "${YELLOW}Stopping rmpcd service...${NC}"
systemctl --user stop rmpcd 2>/dev/null || true

# Kill any orphaned processes that might hold the binary open
pkill -9 rmpcd 2>/dev/null || true
pkill -9 -f "mpv.*yrmpc" 2>/dev/null || true

# Clean up stale sockets
rm -f /tmp/yrmpc-yt.sock /tmp/yrmpc-yt.mpv.sock

# Install directory
INSTALL_DIR="$HOME/.local/bin"
mkdir -p "$INSTALL_DIR"

# Copy binaries
echo "Updating rmpcd..."
install -Dm755 "$RMPCD_BINARY" "$INSTALL_DIR/rmpcd"

echo "Updating rmpc..."
install -Dm755 "$RMPC_BINARY" "$INSTALL_DIR/rmpc"

# Verify installed binary matches built binary
if ! cmp -s "$RMPCD_BINARY" "$INSTALL_DIR/rmpcd"; then
    echo -e "${RED}❌ Installed rmpcd does not match built binary${NC}"
    exit 1
fi
if ! cmp -s "$RMPC_BINARY" "$INSTALL_DIR/rmpc"; then
    echo -e "${RED}❌ Installed rmpc does not match built binary${NC}"
    exit 1
fi

# Reload systemd (in case service file changed)
systemctl --user daemon-reload

# Start daemon
echo -e "${YELLOW}Starting rmpcd service...${NC}"
systemctl --user start rmpcd

# Wait and verify
sleep 2

if systemctl --user is-active --quiet rmpcd; then
    echo -e "${GREEN}✅ rmpcd updated and running!${NC}"
else
    echo -e "${RED}❌ Service failed to start. Check logs:${NC}"
    echo "  journalctl --user -u rmpcd -n 20"
    exit 1
fi
